<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization" Version="9.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Profile\ProfileResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ProfileResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Projects\ProjectsResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ProjectsResources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Profile\ProfileResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ProfileResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Projects\ProjectsResources.resx">
      <LastGenOutput>ProjectsResources.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

	<!-- Solo ejecutar en configuración Release, y solo si se compila a través del .sln
	     (SolutionDir no está definido al compilar el .csproj suelto, como hace Docker/Render) -->
	<Target Name="GenerateTranslations" BeforeTargets="PreBuildEvent" Condition="'$(Configuration)' == 'Release' AND '$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'">
		<PropertyGroup>
			<BuildToolsPath>$(SolutionDir)BuildTools\BuildTools.csproj</BuildToolsPath>
			<CorePath>$(ProjectDir)</CorePath>
		</PropertyGroup>
		<Message Text="Ejecutando traducción automática..." Importance="high" />
		<Exec Command="dotnet run --project $(BuildToolsPath) $(CorePath)" WorkingDirectory="$(SolutionDir)" ContinueOnError="false" />
	</Target>

</Project>
